# ============================================================
# Server Configuration
# ============================================================
PORT=3001
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DB_PATH=./data/cabusenn.db

# ============================================================
# TikTok Login Kit v2 OAuth
# ============================================================
# Register at: https://developers.tiktok.com/
# 1. Create app → Add "Login Kit" product
# 2. Configure redirect URI
# 3. Submit for review
#
# Leave empty to disable TikTok login (invite ID only)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5173/auth/tiktok/callback
